# ============================================================
# 析数项目配置。复制为 .env 后填写本地连接信息和密钥，不把 .env 提交到 Git。
# 修改配置值后，需要重启 API、Worker 和 Beat 才会使用新值。
# ============================================================

# ----- 1. PostgreSQL 数据库连接 -----
# 业务连接用于管理用户、导入数据和更新任务，连接本项目数据库。
DATABASE_URL=postgresql+asyncpg://langgraph_user:CHANGE_ME@127.0.0.1:5432/agent_analytics
# 分析查询使用独立的只读账号，并通过数据库行级权限限定当前数据集。
SQL_READER_URL=postgresql+asyncpg://agent_analytics_reader:CHANGE_ME@127.0.0.1:5432/agent_analytics

# ----- 2. 登录身份验证 -----
# JWT 密钥用于签发和验证登录令牌。请使用至少 32 个字符的随机字符串，不要填写模型 API 密钥。
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ----- 3. Redis 后台任务队列 -----
# Redis 使用本机端口 6380，地址末尾的 /0 表示 Redis 的第 0 号逻辑数据库。
REDIS_URL=redis://127.0.0.1:6380/0

# ----- 4. 模型接口连接 -----
# 使用硅基流动时填写 siliconflow，其他兼容服务填写 compatible，以决定是否发送平台专用参数。
MODEL_PROVIDER=siliconflow
# 设置页面和未指定运行模式的请求默认使用哪种模式：llm 调用聊天模型，demo 使用规则演示。
MODEL_MODE=llm
# 填写模型接口前缀，例如以 /v1 结尾的地址。程序会追加 /chat/completions，无需在这里重复填写。
MODEL_BASE_URL=https://api.siliconflow.cn/v1
# 填写平台提供的完整模型名称，保留组织前缀和正确大小写。
MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
# 在本地 .env 中填写模型 API 密钥，不把真实密钥写入这个示例模板。
MODEL_API_KEY=

# ----- 5. 模型输出与上下文长度 -----
# 设置本项目采用的上下文长度上限。这是请求的保守限制，不是模型官方最大窗口。
MODEL_CONTEXT_TOKENS=32000
# 限制一次模型响应最多生成多少 token。
MODEL_MAX_TOKENS=1800
# temperature 控制生成的随机性。工具调用默认使用较低值，本项目允许范围为 0～2。
MODEL_TEMPERATURE=0.1
# 是否启用硅基流动模型的深度思考。默认关闭，减少工具调用等待。
MODEL_ENABLE_THINKING=false
# 一次模型 HTTP 请求允许等待的最长时间，单位为秒。
MODEL_TIMEOUT_SECONDS=60

# ----- 6. 运行文件存储 -----
# 存储上传数据和分析结果。相对路径从项目根目录开始计算。
STORAGE_ROOT=storage

# ----- 7. Python 执行容器 -----
# 填写执行 Python 所用的 Docker 镜像名称，构建方法见 README。
SANDBOX_IMAGE=agent-analytics-sandbox:local

# ----- 8. Agent 执行次数与时限 -----
# 一次分析最多允许多少轮决策，达到上限后停止，避免无限调用工具。
MAX_AGENT_STEPS=18
# 整个分析任务允许执行的最长时间，单位为秒。
TASK_TIMEOUT_SECONDS=300
# 同一轮独立工具最多同时执行几个，避免占满数据库连接和计算资源。
TOOL_CONCURRENCY=3
# 一次模型决策允许返回的工具数量上限，超出时整批反馈错误，不静默丢弃调用。
MAX_TOOLS_PER_ROUND=8

# ----- 9. 上传文件大小 -----
# 一次上传的所有文件合计大小上限，单位为 MiB。
MAX_UPLOAD_MB=40

# ----- 10. SQL 行数与查询时限 -----
# 一次查询最多返回多少行。超过上限会明确报错，要求聚合或缩小范围，不自动删除多余行。
MAX_SQL_ROWS=1000
# 单条 SQL 最长执行时间，单位为毫秒。
SQL_TIMEOUT_MS=10000

# ----- 11. 长期记忆存储与检索 -----
# 关闭后不再学习或检索记忆，已经保存的记录仍可以查看和管理。
MEMORY_ENABLED=true
# 复用已有 Milvus 容器，但使用本项目专用数据库，与项目一的书籍向量分开保存。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=agent_analytics_memory
MILVUS_COLLECTION=user_memories
MILVUS_TIMEOUT_SECONDS=5
# 依次设置候选模板数量、最低余弦相似度和模板至少出现在多少个成功任务中才可推荐。
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.4
MEMORY_PATTERN_MIN_USES=2

# ----- 12. 文本嵌入模型 -----
# EMBEDDING_API_KEY 留空时使用 MODEL_API_KEY。模型密钥不保存为用户记忆。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 已创建的集合使用 1024 维向量，更换嵌入模型前需要确认输出维度与集合一致。
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=15

# ----- 13. 历史消息与摘要 -----
# 设置保留多少条近期原消息。工具调用和结果需一起保留，实际保留数量可能稍多。
CONTEXT_RECENT_MESSAGES=6
# 消息达到可用输入长度的这一比例时，开始总结尚未处理的旧消息。
CONTEXT_SUMMARY_TRIGGER=0.65
# 限制摘要最多生成多少 token，完整原文仍保存在 PostgreSQL 和图的 checkpoint 中。
CONTEXT_SUMMARY_MAX_TOKENS=700
